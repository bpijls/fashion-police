# ─────────────────────────────────────────────────────────────────────
# Fashion Police — configuration template.
#
#   cp .env.example .env   and fill in the blanks.
#
# .env is gitignored. Never commit real hostnames, IP addresses, domains,
# VPN identifiers or secrets — keep them all here in your local .env.
# ─────────────────────────────────────────────────────────────────────

# ── shared ───────────────────────────────────────────────────────────
# Secret the backend presents to the compute service (X-Compute-Secret).
#   generate: openssl rand -hex 24
COMPUTE_SECRET=

# Optional Hugging Face token — higher download rate limits / private repos.
HF_TOKEN=

# Where model weights are cached on the compute host (bind mount / volume).
HF_HOME=./models


# ── compute tier  (runs on the CUDA host) ────────────────────────────
FP_COMPUTE_DEVICE=auto                                   # auto | cuda | cpu
FP_COMPUTE_SCORER=fashionclip                            # fashionclip | sklearn
FP_COMPUTE_SEGMENTATION_MODEL=mattmdjaga/segformer_b2_clothes
FP_COMPUTE_STYLE_MODEL=patrickjohncyh/fashion-clip
FP_COMPUTE_UNCERTAIN_BELOW=0.22
FP_COMPUTE_MAX_IMAGE_EDGE=1024

# Address the compute container publishes on. Use the host's private / VPN
# address (NOT 0.0.0.0) so the service is not reachable from the internet.
COMPUTE_BIND_ADDR=127.0.0.1
COMPUTE_PORT=8801


# ── backend tier  (reverse-proxy host) ───────────────────────────────
# URL the backend uses to reach compute over the private network.
COMPUTE_URL=http://127.0.0.1:8801
# Optional bearer token the kiosk must send (Authorization: Bearer …).
KIOSK_TOKEN=
# Retention for stored anonymised overlays + prediction rows (days).
RETENTION_DAYS=14
# Face verify-and-discard: required | best_effort | off
FP_BACKEND_FACE_CHECK=required
# Address the backend container publishes on (behind the reverse proxy).
BACKEND_BIND_ADDR=127.0.0.1
BACKEND_PORT=8800

# Public hostname served through the reverse proxy (Caddy).
APP_DOMAIN=
# Reverse-proxy ingress network name.
CADDY_NETWORK=


# ── frontend tier  (kiosk device) ───────────────────────────────────
# Backend API base path as seen by the kiosk browser (same origin in prod).
VITE_API_BASE=/api/v1
# Set to /models to load the TF.js detectors from bundled files (offline kiosk).
VITE_MODEL_BASE=
